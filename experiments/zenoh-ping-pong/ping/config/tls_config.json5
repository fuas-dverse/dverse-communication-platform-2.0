{
  "mode": "client",
  "connect": {
    "endpoints": ["tls/zenoh.local:7447"]
  },
  "scouting": {
    "multicast": {
      "enabled": false
    }
  },
  "transport": {
    "link": {
      "tls": {
        enable_mtls: true,
        root_ca_certificate: "/stuff/programming/uni/css-7/dverse-communication-platform-2.0/experiments/zenoh-ping-pong/certs/ca.crt",
        connect_private_key: "/stuff/programming/uni/css-7/dverse-communication-platform-2.0/experiments/zenoh-ping-pong/certs/client.key",
        connect_certificate: "/stuff/programming/uni/css-7/dverse-communication-platform-2.0/experiments/zenoh-ping-pong/certs/client.crt",
      }
    }
  }
}
