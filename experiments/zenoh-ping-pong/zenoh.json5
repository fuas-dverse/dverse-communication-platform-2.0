{
  mode: "peer",

  listen: {
    endpoints: ["tls/0.0.0.0:7447"],
  },

  transport: {
    link: {
      tls: {
        listen_certificate:     "./certs/server.crt",
        listen_private_key:     "./certs/server.key",
        root_ca_certificate:    "./certs/ca.crt",
        verify_name_on_connect: true,
        enable_mtls:         true,

      }
    }
  }
}
