# Secret key for signing JWT tokens. Use a long random string in production.
SECRET_KEY=change-me-to-a-long-random-secret

# Anthropic API key — required when using bots with provider=claude
ANTHROPIC_API_KEY=sk-ant-...

# Zenoh router — used when provider=zenoh (external bot agents connect here)
ZENOH_ROUTER=tcp/localhost:7447

# Local LLM settings — used when provider=local (e.g. Ollama)
# Base URL for local inference. For Ollama use http://localhost:11434.
# If you run an OpenAI-compatible proxy, you can set this to .../v1.
LOCAL_LLM_URL=http://localhost:11434
# Model name to use for local inference
LOCAL_LLM_MODEL=deepseek-r1:1.5b
# Timeout for local LLM requests (seconds)
LOCAL_LLM_TIMEOUT_SECONDS=240

# Max recent messages included when building bot context
BOT_HISTORY_LIMIT=40

# Print the exact bot context payload in backend logs (debugging)
BOT_DEBUG_CONTEXT=false
